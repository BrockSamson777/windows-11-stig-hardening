<#
.SYNOPSIS
    This PowerShell script disables printing over HTTP on Windows 11.

.NOTES
    Author          : Victor Johnson
    LinkedIn        : https://www.linkedin.com/in/v-johns/
    GitHub          : github.com/BrockSamson777
    Date Created    : 08/24/2026
    Last Modified   : 08/24/2026
    Version         : 1.0
    CVEs            : N/A
    Plugin IDs      : N/A
    STIG-ID         : WN11-CC-000110
    Documentation   : https://stigaview.com/products/win11/latest/WN11-CC-000110/

.TESTED ON
    Date(s) Tested  : 08/24/2026
    Tested By       : Victor Johnson
    Systems Tested  : Windows 11
    PowerShell Ver. : 5.1

.USAGE
    Run PowerShell as Administrator.

    Example syntax:
    PS C:\> .\WN11-CC-000110.ps1
#>

# Define the registry path required by the STIG
$RegistryPath = "HKLM:\SOFTWARE\Policies\Microsoft\Windows NT\Printers"

# Create the registry path if it does not already exist
New-Item -Path $RegistryPath -Force | Out-Null

# Disable printing over HTTP
New-ItemProperty `
    -Path $RegistryPath `
    -Name "DisableHTTPPrinting" `
    -PropertyType DWord `
    -Value 1 `
    -Force | Out-Null

# Verify the registry value
$Result = Get-ItemProperty `
    -Path $RegistryPath `
    -Name "DisableHTTPPrinting"

Write-Host "WN11-CC-000110 remediation complete."
Write-Host "DisableHTTPPrinting =" $Result.DisableHTTPPrinting
