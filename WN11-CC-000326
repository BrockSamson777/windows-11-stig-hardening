<#
.SYNOPSIS
    This PowerShell script enables PowerShell Script Block Logging on Windows 11.

.NOTES
    Author          : Victor Johnson
    LinkedIn        : https://www.linkedin.com/in/v-johns/
    GitHub          : github.com/BrockSamson777
    Date Created    : 08/24/2026
    Last Modified   : 08/24/2026
    Version         : 1.0
    CVEs            : N/A
    Plugin IDs      : N/A
    STIG-ID         : WN11-CC-000326
    Documentation   : https://stigaview.com/products/win11/latest/WN11-CC-000005/

.TESTED ON
    Date(s) Tested  : 08/24/2026
    Tested By       : Victor Johnson
    Systems Tested  : Windows 11
    PowerShell Ver. : 5.1

.USAGE
    Run PowerShell as Administrator.

    Example syntax:
    PS C:\> .\WN11-CC-000326.ps1
#>

$Path = "HKLM:\SOFTWARE\Policies\Microsoft\Windows\PowerShell\ScriptBlockLogging"

New-Item -Path $Path -Force | Out-Null

New-ItemProperty -Path $Path `
    -Name "EnableScriptBlockLogging" `
    -PropertyType DWord `
    -Value 1 `
    -Force | Out-Null

Write-Host "WN11-CC-000326 remediated successfully."
Write-Host "PowerShell Script Block Logging has been enabled."
