<#
.SYNOPSIS
    This PowerShell script disables indexing of encrypted files on Windows 11.

.NOTES
    Author          : <Your Name>
    LinkedIn        : <Your LinkedIn>
    GitHub          : <Your GitHub>
    Date Created    : 2026-08-24
    Last Modified   : 2026-08-24
    Version         : 1.0
    CVEs            : N/A
    Plugin IDs      : N/A
    STIG-ID         : WN11-CC-000305
    Documentation   : STIG-A-View - Windows 11 - WN11-CC-000305

.TESTED ON
    Date(s) Tested  :
    Tested By       :
    Systems Tested  : Windows 11
    PowerShell Ver. :

.USAGE
    Run PowerShell as Administrator.

    Example syntax:
    PS C:\> .\WN11-CC-000305.ps1
#>

$Path = "HKLM:\SOFTWARE\Policies\Microsoft\Windows\Windows Search"

New-Item -Path $Path -Force | Out-Null

New-ItemProperty -Path $Path `
    -Name "AllowIndexingEncryptedStoresOrItems" `
    -PropertyType DWord `
    -Value 0 `
    -Force | Out-Null

Write-Host "WN11-CC-000305 remediated successfully."
Write-Host "Indexing of encrypted files has been disabled."
