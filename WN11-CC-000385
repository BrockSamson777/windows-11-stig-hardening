<#
.SYNOPSIS
    This PowerShell script configures Windows Ink Workspace to disallow access above the Windows lock screen.

.NOTES
    Author          : Victor Johnson
    LinkedIn        : https://www.linkedin.com/in/v-johns/
    GitHub          : github.com/BrockSamson777
    Date Created    : 08/24/2026
    Last Modified   : 08/24/2026
    Version         : 1.0
    CVEs            : N/A
    Plugin IDs      : N/A
    STIG-ID         : WN11-CC-000385
    Documentation   : https://stigaview.com/products/win11/latest/WN11-CC-000005/

.TESTED ON
    Date(s) Tested  : 08/24/2026
    Tested By       : Victor Johnson
    Systems Tested  : Windows 11
    PowerShell Ver. : 5.1
.USAGE
    Run PowerShell as Administrator.

    Example syntax:
    PS C:\> .\WN11-CC-000385.ps1
#>

$Path = "HKLM:\SOFTWARE\Policies\Microsoft\WindowsInkWorkspace"

New-Item -Path $Path -Force | Out-Null

New-ItemProperty -Path $Path `
    -Name "AllowWindowsInkWorkspace" `
    -PropertyType DWord `
    -Value 1 `
    -Force | Out-Null

Write-Host "WN11-CC-000385 remediated successfully."
Write-Host "Windows Ink Workspace access above the lock screen has been restricted."
