<#
.SYNOPSIS
    This PowerShell script enables PowerShell Transcription on Windows 11.

.NOTES
    Author          : <Your Name>
    LinkedIn        : <Your LinkedIn>
    GitHub          : <Your GitHub>
    Date Created    : 2026-08-24
    Last Modified   : 2026-08-24
    Version         : 1.0
    CVEs            : N/A
    Plugin IDs      : N/A
    STIG-ID         : WN11-CC-000327
    Documentation   : STIG-A-View - Windows 11 - WN11-CC-000327

.TESTED ON
    Date(s) Tested  :
    Tested By       :
    Systems Tested  : Windows 11
    PowerShell Ver. :

.USAGE
    Run PowerShell as Administrator.

    Example syntax:
    PS C:\> .\WN11-CC-000327.ps1
#>

$Path = "HKLM:\SOFTWARE\Policies\Microsoft\Windows\PowerShell\Transcription"

New-Item -Path $Path -Force | Out-Null

New-ItemProperty -Path $Path `
    -Name "EnableTranscripting" `
    -PropertyType DWord `
    -Value 1 `
    -Force | Out-Null

Write-Host "WN11-CC-000327 remediated successfully."
Write-Host "PowerShell Transcription has been enabled."
