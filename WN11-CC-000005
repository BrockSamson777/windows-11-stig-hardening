<#
.SYNOPSIS
    This PowerShell script disables camera access from the Windows 11 lock screen.

.NOTES
    Author          : <Your Name>
    LinkedIn        : <Your LinkedIn>
    GitHub          : <Your GitHub>
    Date Created    : 2026-08-24
    Last Modified   : 2026-08-24
    Version         : 1.0
    CVEs            : N/A
    Plugin IDs      : N/A
    STIG-ID         : WN11-CC-000005
    Documentation   : STIG-A-View - Windows 11 - WN11-CC-000005

.TESTED ON
    Date(s) Tested  :
    Tested By       :
    Systems Tested  : Windows 11
    PowerShell Ver. :

.USAGE
    Run PowerShell as Administrator.

    Example syntax:
    PS C:\> .\WN11-CC-000005.ps1
#>

$Path = "HKLM:\SOFTWARE\Policies\Microsoft\Windows\Personalization"

New-Item -Path $Path -Force | Out-Null

New-ItemProperty -Path $Path `
    -Name "NoLockScreenCamera" `
    -PropertyType DWord `
    -Value 1 `
    -Force | Out-Null

Write-Host "WN11-CC-000005 remediated successfully."
Write-Host "Camera access from the lock screen has been disabled."
